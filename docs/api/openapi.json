  "components": {
    "schemas": {
      "ApiMeta": {
        "type": "object",
        "required": [
          "source",
          "sources",
          "source_url",
          "last_verified_at",
          "verification_status"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_status": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "CollectionEnvelope": {
        "type": "object",
        "required": [
          "data",
