{
  "openapi": "3.1.0",
  "info": {
    "title": "Laghubitta Khabar B2B API",
    "version": "1.0.0",
    "description": "Read-only v1 contract (docs/API-CONTRACT.md). Every payload carries provenance; missing values are absent or provable zeros, never fabricated. No POST/PUT/DELETE."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local development (scripts/api-server.ts)"
    }
  ],
  "tags": [
    {
      "name": "Meta",
      "description": "Discovery and contract metadata."
    },
    {
      "name": "Institutions",
      "description": "Canonical institution records and their sub-resources."
    },
    {
      "name": "People",
      "description": "Tier-1/2 board and senior management profiles."
    },
    {
      "name": "News",
      "description": "News records typed by source tier."
    },
    {
      "name": "Search",
      "description": "Cross-entity free-text search."
    },
    {
      "name": "Interest rates",
      "description": "Canonical interest-rate notices (values never extracted)."
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "summary": "Discovery index: API name, version, and every read-only endpoint.",
        "operationId": "get_api",
        "tags": [
          "Meta"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Discovery index: API name, version, and every read-only endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "405": {
            "description": "Read-only API: only GET/HEAD are supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/institutions": {
      "get": {
        "summary": "List canonical institutions (directory).",
        "operationId": "get_api_institutions",
        "tags": [
          "Institutions"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Substring match on name, source name, or alias.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "province",
            "in": "query",
            "required": false,
            "description": "Substring match on working area + head office.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by website status vocabulary.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based). Default 1.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size. Default 20, max 100.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List canonical institutions (directory).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            }
          },
          "405": {
            "description": "Read-only API: only GET/HEAD are supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
