{
  "build": {
    "command": "npm run build",
    "output_directory": "out",
    "environment": {
      "NODE_VERSION": "24"
    }
  },
  "routes": [
    { "pattern": "/*", "execute": [".auth"] },
    { "pattern": "/images/*", "execute": [] },
    { "pattern": "/icons/*", "execute": [] },
    { "pattern": "/_next/static/*", "execute": [] }
  ]
}